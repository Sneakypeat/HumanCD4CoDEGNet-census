# Pandoc build intermediates — regenerated by scripts/build_pdf.py / build_docx.py
_build.md
_build_docx.md
_results_build.md

# Word lock files, OS and Python junk
~$*.docx
.DS_Store
__pycache__/
*.pyc

# Large regenerable third-party caches (re-fetched by the scripts that use them)
# (the old rule excluded data/ entirely; that directory now holds the
#  committed analysis inputs the figure scripts read, so it must ship)

# local caches for scripts (see CODEG_CACHE)
.cache/

# Third-party PDFs, superseded review renders and legacy trees: kept locally,
# not part of the submission repository.
nature15545.pdf
_legacy/
RESULTS.html
RESULTS_for_PI_review.html
RESULTS_for_PI_review.pdf
RESULTS_for_review.html
# Final figures ship as PDF only. Intermediates and PNG renders are build
# products: the scripts regenerate them.
figures/*.png
figures/FigS3_base.pdf
figures/Fig4_supp.pdf
magma_inputs/

# Guard and audit logs: provenance noise, kept locally
*.guard.log
*.render.log
*.audit.log

